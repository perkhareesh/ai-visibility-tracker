# PostgreSQL connection string
DATABASE_URL=postgres://postgres@localhost:5432/aivt
# Used by integration tests only (database is wiped by the tests)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/aivt_test

# Live provider: OpenAI Responses API with the web_search tool.
# Leave empty to run without live tracking (demo workspace still works).
OPENAI_API_KEY=
# Model used for tracking runs. Must support the web_search tool.
OPENAI_MODEL=gpt-5.5
# "auto" lets the model decide whether to search (closer to ChatGPT behaviour);
# "required" forces a web search on every prompt.
OPENAI_WEB_SEARCH_TOOL_CHOICE=auto
# Request timeout per provider call (ms)
PROVIDER_TIMEOUT_MS=90000

# Run the job worker inside the Next.js server process (handy locally).
# Set to false in production and run `npm run worker` as a separate process.
WORKER_INLINE=true
WORKER_POLL_MS=2000
# Max provider calls per minute per workspace
PROVIDER_RATE_LIMIT_PER_MIN=20

# Session cookie security. Set to true behind HTTPS.
COOKIE_SECURE=false
